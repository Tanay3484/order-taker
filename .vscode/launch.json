{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Order Taker",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "console": "integratedTerminal",
      "env": { "ORDER_MODEL": "qwen2.5:7b" }
    },
    {
      "name": "Run tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "console": "integratedTerminal"
    },
    {
      "name": "Benchmark intake (old vs new)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/bench_intake.py",
      "console": "integratedTerminal"
    }
  ]
}
